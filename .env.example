# Copy this file to .env and fill in real values. Never commit .env.

# Ambiente: development | production
# In production: errori mai mostrati a video, cache HTTP attiva, HSTS su HTTPS.
# In development: risposte marcate noindex (fuori dai motori di ricerca).
APP_ENV=development
APP_URL=https://dev2x1000.almagioni.com

# Connessione MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=2x1000
DB_USER=2x1000_user
DB_PASS=changeme
DB_CHARSET=utf8mb4

# Soglia minima di scelte nell'anno precedente per essere incluso nelle
# classifiche di crescita/calo percentuale (evita distorsioni su numeri piccoli)
GROWTH_MIN_PREVIOUS_CHOICES=5000

# Durata (secondi) della cache HTTP di pagine e API in produzione. I dati
# cambiano una volta l'anno: 600 è prudente, si può alzare. 0 la disattiva.
CACHE_MAX_AGE=600
